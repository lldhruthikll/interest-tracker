generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int      @id @default(autoincrement())
  username           String   @unique
  password           String
  name               String   @default("Admin")
  createdAt          DateTime @default(now())
  role               String   @default("MEMBER") // ADMIN, MEMBER, PAYER
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  payerId            Int?     @unique
  payer              Payer?   @relation("PayerLogin", fields: [payerId], references: [id])

  borrowers          Borrower[]
  loans              Loan[]
  categories         Category[]
  places             Place[]
  units              Unit[]
  payers             Payer[]               @relation("PayerOwner")
  agreements         Agreement[]
  rateChanges        RateChange[]
  recurringDues      RecurringDue[]
  recurringPayments  RecurringPayment[]
  recurringAllocs    RecurringAllocation[]
  advanceEntries     AdvanceEntry[]
  interestRecords    InterestRecord[]
  payments           Payment[]
  paymentAllocations PaymentAllocation[]
  creditors          Creditor[]
  debtEntries        DebtEntry[]
}

model Borrower {
  id        Int       @id @default(autoincrement())
  ownerId   Int
  owner     User      @relation(fields: [ownerId], references: [id])
  name      String
  phone     String
  address   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  loans     Loan[]
  payments  Payment[]

  @@index([ownerId])
}

model Loan {
  id              Int              @id @default(autoincrement())
  ownerId         Int
  owner           User             @relation(fields: [ownerId], references: [id])
  borrowerId      Int
  borrower        Borrower         @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  principal       Decimal          @db.Decimal(12, 2)
  monthlyInterest Decimal          @db.Decimal(12, 2)
  startDate       DateTime         @db.Date
  dueDay          Int // Day of the month (1-31)
  status          String           @default("ACTIVE") // ACTIVE, CLOSED
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  interestRecords InterestRecord[]
  payments        Payment[]

  @@index([ownerId])
}

model InterestRecord {
  id          Int                 @id @default(autoincrement())
  ownerId     Int
  owner       User                @relation(fields: [ownerId], references: [id])
  loanId      Int
  loan        Loan                @relation(fields: [loanId], references: [id], onDelete: Cascade)
  dueDate     DateTime            @db.Date
  periodName  String // e.g. "April 2026"
  amount      Decimal             @db.Decimal(12, 2) // Monthly interest amount expected
  paidAmount  Decimal             @default(0) @db.Decimal(12, 2)
  status      String              @default("PENDING") // PENDING, PARTIALLY_PAID, PAID
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  allocations PaymentAllocation[]

  @@unique([loanId, dueDate])
  @@index([ownerId])
}

model Payment {
  id          Int                 @id @default(autoincrement())
  ownerId     Int
  owner       User                @relation(fields: [ownerId], references: [id])
  borrowerId  Int
  borrower    Borrower            @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  loanId      Int?
  loan        Loan?               @relation(fields: [loanId], references: [id], onDelete: SetNull)
  amount      Decimal             @db.Decimal(12, 2) // Total payment amount entered
  paymentDate DateTime            @default(now())
  notes       String?
  createdAt   DateTime            @default(now())
  allocations PaymentAllocation[]

  @@index([ownerId])
}

model PaymentAllocation {
  id               Int            @id @default(autoincrement())
  ownerId          Int
  owner            User           @relation(fields: [ownerId], references: [id])
  paymentId        Int
  payment          Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  interestRecordId Int
  interestRecord   InterestRecord @relation(fields: [interestRecordId], references: [id], onDelete: Cascade)
  amount           Decimal        @db.Decimal(12, 2) // Amount allocated to this monthly interest record
  createdAt        DateTime       @default(now())

  @@index([ownerId])
}

model Category {
  id         Int      @id @default(autoincrement())
  ownerId    Int
  owner      User     @relation(fields: [ownerId], references: [id])
  name       String
  placeLabel String
  unitLabel  String
  payerLabel String
  color      String?
  archived   Boolean  @default(false)
  places     Place[]
  createdAt  DateTime @default(now())

  @@index([ownerId])
}

model Place {
  id         Int      @id @default(autoincrement())
  ownerId    Int
  owner      User     @relation(fields: [ownerId], references: [id])
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  name       String
  address    String?
  archived   Boolean  @default(false)
  units      Unit[]
  createdAt  DateTime @default(now())

  @@index([ownerId])
}

model Unit {
  id            Int         @id @default(autoincrement())
  ownerId       Int
  owner         User        @relation(fields: [ownerId], references: [id])
  placeId       Int
  place         Place       @relation(fields: [placeId], references: [id])
  name          String
  defaultAmount Decimal     @db.Decimal(12, 2)
  notes         String?
  archived      Boolean     @default(false)
  agreements    Agreement[]
  createdAt     DateTime    @default(now())

  @@index([ownerId])
}

model Payer {
  id         Int         @id @default(autoincrement())
  ownerId    Int
  owner      User        @relation("PayerOwner", fields: [ownerId], references: [id])
  name       String
  phone      String
  notes      String?
  user       User?       @relation("PayerLogin")
  agreements Agreement[]
  createdAt  DateTime    @default(now())

  @@index([ownerId])
}

model Agreement {
  id             Int                @id @default(autoincrement())
  ownerId        Int
  owner          User               @relation(fields: [ownerId], references: [id])
  unitId         Int
  unit           Unit               @relation(fields: [unitId], references: [id])
  payerId        Int
  payer          Payer              @relation(fields: [payerId], references: [id])
  startDate      DateTime           @db.Date
  endDate        DateTime?          @db.Date
  dueDay         Int
  timing         String // IN_ADVANCE, IN_ARREARS
  firstMonthRule String // PRORATED, FULL, FREE
  lastMonthRule  String
  status         String             @default("ACTIVE") // ACTIVE, ENDED
  notes          String?
  rateChanges    RateChange[]
  dues           RecurringDue[]
  payments       RecurringPayment[]
  advances       AdvanceEntry[]
  createdAt      DateTime           @default(now())

  @@index([ownerId])
}

model RateChange {
  id            Int       @id @default(autoincrement())
  ownerId       Int
  owner         User      @relation(fields: [ownerId], references: [id])
  agreementId   Int
  agreement     Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  amount        Decimal   @db.Decimal(12, 2)
  effectiveFrom String // YYYY-MM
  createdAt     DateTime  @default(now())

  @@unique([agreementId, effectiveFrom])
  @@index([ownerId])
}

model RecurringDue {
  id          Int                   @id @default(autoincrement())
  ownerId     Int
  owner       User                  @relation(fields: [ownerId], references: [id])
  agreementId Int
  agreement   Agreement             @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  period      String // YYYY-MM
  dueDate     DateTime              @db.Date
  amount      Decimal               @db.Decimal(12, 2)
  paidAmount  Decimal               @default(0) @db.Decimal(12, 2)
  status      String                @default("PENDING")
  allocations RecurringAllocation[]
  createdAt   DateTime              @default(now())

  @@unique([agreementId, period])
  @@index([ownerId])
}

model RecurringPayment {
  id          Int                   @id @default(autoincrement())
  ownerId     Int
  owner       User                  @relation(fields: [ownerId], references: [id])
  agreementId Int
  agreement   Agreement             @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  amount      Decimal               @db.Decimal(12, 2)
  paymentDate DateTime              @db.Date
  method      String // CASH, UPI, BANK, CHEQUE, ADVANCE
  notes       String?
  allocations RecurringAllocation[]
  advances    AdvanceEntry[]
  debtEntry   DebtEntry?
  createdAt   DateTime              @default(now())

  @@index([ownerId])
}

model RecurringAllocation {
  id        Int              @id @default(autoincrement())
  ownerId   Int
  owner     User             @relation(fields: [ownerId], references: [id])
  paymentId Int
  payment   RecurringPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  dueId     Int
  due       RecurringDue     @relation(fields: [dueId], references: [id], onDelete: Cascade)
  amount    Decimal          @db.Decimal(12, 2)
  createdAt DateTime         @default(now())

  @@index([ownerId])
}

model AdvanceEntry {
  id          Int               @id @default(autoincrement())
  ownerId     Int
  owner       User              @relation(fields: [ownerId], references: [id])
  agreementId Int
  agreement   Agreement         @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  type        String // RECEIVED, APPLIED_TO_RENT, RETAINED, REFUNDED, CREDIT_REFUNDED
  amount      Decimal           @db.Decimal(12, 2)
  date        DateTime          @db.Date
  notes       String?
  paymentId   Int?
  payment     RecurringPayment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())

  @@index([ownerId])
}

// Money I owe: people the owner borrowed from. Balance = BORROWED − REPAID entries (no interest).
model Creditor {
  id        Int         @id @default(autoincrement())
  ownerId   Int
  owner     User        @relation(fields: [ownerId], references: [id])
  name      String
  phone     String?
  notes     String?
  entries   DebtEntry[]
  createdAt DateTime    @default(now())

  @@index([ownerId])
}

model DebtEntry {
  id         Int               @id @default(autoincrement())
  ownerId    Int
  owner      User              @relation(fields: [ownerId], references: [id])
  creditorId Int
  creditor   Creditor          @relation(fields: [creditorId], references: [id], onDelete: Cascade)
  type       String // BORROWED, REPAID
  amount     Decimal           @db.Decimal(12, 2)
  date       DateTime          @db.Date
  notes      String?
  paymentId  Int?              @unique // set when a tenant's rent payment was passed on
  payment    RecurringPayment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())

  @@index([ownerId])
  @@index([creditorId])
}
